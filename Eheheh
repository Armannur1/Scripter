-- PiggyESP v4 (LocalScript) - for use with the developer's permission.
-- Put in StarterPlayer > StarterPlayerScripts.
--
-- Categories (each can be switched on/off in the menu; an OFF category has no
-- outlines, labels or per-frame work at all):
--   Player piggy  character with an "Enemy" child            (red)
--   Bot piggy     anything inside workspace.PiggyNpc          (blue)
--   Trap          part-type traps in the item folder          (purple)
--   NPC trap      model-type traps in the item folder         (dark red)
--   Traitor       character with a "Traitor" child            (orange)
--   Ability       TrickOrTreat, Flare, Crafty, Radar, Warp, Decoy... (green)
--   Item          everything else directly in the item folder (yellow)
-- The item folder is found by shape: a workspace child named "ItemFolder" or
-- all digits (the game renames it).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local DEBUG = false
local function dbg(...)
	if DEBUG then print("[PiggyESP]", ...) end
end

--------------------------------------------------------------------
-- CONFIG (edit freely)
--------------------------------------------------------------------
local CATEGORIES = {
	{ key = "player",  label = "Player piggy", color = Color3.fromRGB(255, 50, 50),  default = true },
	{ key = "bot",     label = "Bot piggy",    color = Color3.fromRGB(60, 130, 255), default = true },
	{ key = "trap",    label = "Trap",         color = Color3.fromRGB(170, 80, 255), default = true },
	{ key = "npctrap", label = "NPC trap",     color = Color3.fromRGB(150, 0, 0),    default = true },
	{ key = "traitor", label = "Traitor",      color = Color3.fromRGB(255, 140, 0),  default = true },
	{ key = "ability", label = "Ability",      color = Color3.fromRGB(60, 220, 90),  default = false },
	{ key = "item",    label = "Item",         color = Color3.fromRGB(255, 225, 40), default = false },
}

-- Settings defaults
local settings = {
	fill = false,      -- colored fill inside the outline
	distance = true,   -- show [distance] in labels
	hideFar = false,   -- hide outlines/labels beyond farDist
	farDist = 150,     -- studs (changeable in the menu, steps of 25)
}

-- Name matching (not case sensitive, matches part of the name)
local TRAP_KEYWORDS = { "trap", "piggy" }
local TRAP_EXCLUDE = {}                       -- e.g. { "trapdoor" }
local NPC_TRAP_NAMES = { "crawltrap" }        -- always NPC trap (also catches CrawlTrapAlt)
local ABILITY_KEYWORDS = { "trickortreat", "flare", "crafty", "radar", "warp", "decoy", "disarm" }

--------------------------------------------------------------------
-- State
--------------------------------------------------------------------
local masterOn = true
local on, COLOR = {}, {}
for _, c in ipairs(CATEGORIES) do
	on[c.key] = c.default
	COLOR[c.key] = c.color
end

local MARKERS = { Enemy = true, Traitor = true }
local tracked = {} -- [instance] = {source, direct, cat, name, hl, gui, label, root, text, far, conns}

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function hasKeyword(lname, list)
	for i = 1, #list do
		if lname:find(list[i], 1, true) then return true end
	end
	return false
end

local function getPlayer(model)
	if not model:IsA("Model") then return nil end
	local p = Players:GetPlayerFromCharacter(model)
	if p then return p end
	if model.Parent == workspace then
		local byName = Players:FindFirstChild(model.Name)
		if byName and byName:IsA("Player") then return byName end
	end
end

local function pickPart(model)
	if model:IsA("BasePart") then return model end
	return model:FindFirstChild("Head")
		or model:FindFirstChild("HumanoidRootPart")
		or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart", true)
end

local function getRoot(model, t)
	local r = t.root
	if r and r.Parent then return r end
	if model:IsA("BasePart") then
		r = model
	else
		r = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			or model:FindFirstChildWhichIsA("BasePart", true)
	end
	t.root = r
	return r
end

local function displayName(model, t)
	if t.source == "player" then
		local p = getPlayer(model)
		return p and p.Name or model.Name
	end
	local n = model.Name
	if n:match("^%d+$") then return "Item" end
	return n
end

--------------------------------------------------------------------
-- Classification: which category is this target in right now?
--------------------------------------------------------------------
local function classify(model, t)
	local src = t.source
	if src == "player" then
		if model:FindFirstChild("Traitor") then return "traitor" end
		if model:FindFirstChild("Enemy") then return "player" end
		return nil
	end

	local lname = model.Name:lower()

	if src == "bot" then
		if hasKeyword(lname, ABILITY_KEYWORDS) then return "ability" end -- "Decoy" lives here
		return "bot"
	end

	-- source == "folder" (the item folder)
	if hasKeyword(lname, NPC_TRAP_NAMES) then return "npctrap" end
	if hasKeyword(lname, ABILITY_KEYWORDS) then return "ability" end
	if hasKeyword(lname, TRAP_KEYWORDS) and not hasKeyword(lname, TRAP_EXCLUDE) then
		return model:IsA("Model") and "npctrap" or "trap"
	end
	if t.direct then return "item" end
	return nil
end

--------------------------------------------------------------------
-- Visuals (only exist while the category is on)
--------------------------------------------------------------------
local function removeVisuals(t)
	if t.hl then t.hl:Destroy() t.hl = nil end
	if t.gui then t.gui:Destroy() t.gui = nil t.label = nil end
	t.text, t.far = nil, nil
end

local function applyVisuals(model, t)
	local cat = t.cat
	if not (masterOn and cat and on[cat]) then
		if t.hl then removeVisuals(t) end
		return
	end
	if not model.Parent then return end

	local color = COLOR[cat]
	if not t.hl then
		local hl = Instance.new("Highlight")
		hl.Adornee = model
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.OutlineTransparency = 0
		hl.Parent = model
		t.hl = hl

		local g = Instance.new("BillboardGui")
		g.Size = UDim2.fromOffset(180, 30)
		g.StudsOffset = Vector3.new(0, 3, 0)
		g.AlwaysOnTop = true
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.TextStrokeTransparency = 0
		l.TextScaled = true
		l.Font = Enum.Font.GothamBold
		l.Parent = g
		g.Parent = model
		t.gui, t.label = g, l
	end

	t.hl.FillColor = color
	t.hl.OutlineColor = color
	t.hl.FillTransparency = settings.fill and 0.6 or 1
	t.label.TextColor3 = color
	if not t.gui.Adornee then t.gui.Adornee = pickPart(model) end

	t.name = displayName(model, t)
	t.label.Text = t.name
	t.text = t.name
	t.far = nil
	t.hl.Enabled = true
	t.gui.Enabled = true
end

local function clear(model)
	local t = tracked[model]
	if not t then return end
	removeVisuals(t)
	for _, c in ipairs(t.conns) do c:Disconnect() end
	tracked[model] = nil
end

-- Re-classify one target (only called when something relevant changed)
local function refresh(model)
	local t = tracked[model]
	if not t then return end
	local cat = classify(model, t)
	if cat == t.cat then
		if t.cat and not t.hl and masterOn and on[t.cat] and model.Parent then
			applyVisuals(model, t)
		elseif t.gui and not t.gui.Adornee then
			t.gui.Adornee = pickPart(model)
		end
		return
	end
	t.cat = cat
	applyVisuals(model, t)
end

local function track(model, source, direct)
	if not model or tracked[model] then return end
	if not (model:IsA("Model") or model:IsA("BasePart")) then return end

	local t = { source = source, direct = direct, conns = {} }
	tracked[model] = t
	local conns = t.conns

	if source == "player" then
		-- role changes show up as an Enemy / Traitor child appearing or leaving
		conns[#conns + 1] = model.ChildAdded:Connect(function(c)
			if MARKERS[c.Name] then refresh(model) end
		end)
		conns[#conns + 1] = model.ChildRemoved:Connect(function(c)
			if MARKERS[c.Name] then refresh(model) end
		end)
	else
		-- names can change (e.g. number -> real item name)
		conns[#conns + 1] = model:GetPropertyChangedSignal("Name"):Connect(function()
			local tt = tracked[model]
			if not tt then return end
			tt.cat = classify(model, tt)
			applyVisuals(model, tt)
		end)
	end

	conns[#conns + 1] = model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			clear(model)
		else
			local tt = tracked[model]
			if tt and tt.cat and not tt.hl then applyVisuals(model, tt) end
		end
	end)

	refresh(model)
end

local function refreshAll()
	for model, t in pairs(tracked) do applyVisuals(model, t) end
end

--------------------------------------------------------------------
-- Distance / hide-far tick (5 times a second, skipped when not needed)
--------------------------------------------------------------------
local function tick()
	if not masterOn or not (settings.distance or settings.hideFar) then return end
	local char = LocalPlayer.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	local myPos = myRoot.Position
	local hideFar, farDist, showDist = settings.hideFar, settings.farDist, settings.distance

	for model, t in pairs(tracked) do
		local hl = t.hl
		if hl then
			local r = getRoot(model, t)
			if r then
				local d = (r.Position - myPos).Magnitude
				if hideFar then
					local far = d > farDist
					if far ~= t.far then
						t.far = far
						hl.Enabled = not far
						t.gui.Enabled = not far
					end
				elseif t.far then
					t.far = false
					hl.Enabled = true
					t.gui.Enabled = true
				end
				if showDist and not t.far then
					local text = string.format("%s [%d]", t.name, math.floor(d))
					if text ~= t.text then
						t.text = text
						t.label.Text = text
					end
				end
			end
		end
	end
end

local function applySettings()
	refreshAll()
	tick()
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.2 then return end
	acc = 0
	tick()
end)

